<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Properties" 
        Height="620" Width="580" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F8FAFC" 
        FontFamily="Segoe UI" 
        FontSize="12">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" Padding="12,10" CornerRadius="4" Margin="0,0,0,12">
            <DockPanel>
                <TextBlock x:Name="PropHeaderName" Text="ProcessName.exe" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="PropHeaderPid" Text="(PID: 0000)" Foreground="#38BDF8" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Details TabControl -->
        <TabControl Grid.Row="1">
            <!-- Tab 1: General Details & Hierarchy Tree -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4">
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Parent PID:" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock x:Name="PropParentPid" Grid.Column="1" Text="0"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="User Account:" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock x:Name="PropUser" Grid.Column="1" Text="N/A"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Architecture:" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock x:Name="PropArch" Grid.Column="1" Text="x64"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Start Time:" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock x:Name="PropStartTime" Grid.Column="1" Text="N/A"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Executable Path:" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Top"/>
                            <TextBox x:Name="PropPath" Grid.Column="1" Text="N/A" IsReadOnly="True" TextWrapping="Wrap" Background="White" BorderBrush="#CBD5E1" Padding="4,2"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Command Line:" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Top"/>
                            <TextBox x:Name="PropCmdLine" Grid.Column="1" Text="N/A" IsReadOnly="True" TextWrapping="Wrap" Background="White" BorderBrush="#CBD5E1" Padding="4,2" MaxHeight="80" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <Separator Margin="0,8"/>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Current CPU %:" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock x:Name="PropCpu" Grid.Column="1" Text="0.0%" FontWeight="Bold" Foreground="#059669"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Working Set RAM:" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock x:Name="PropRam" Grid.Column="1" Text="0 MB" FontWeight="Bold" Foreground="#7C3AED"/>
                        </Grid>

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Threads / Handles:" FontWeight="SemiBold" Foreground="#475569"/>
                            <TextBlock x:Name="PropThreadsHandles" Grid.Column="1" Text="0 Threads / 0 Handles"/>
                        </Grid>

                        <Separator Margin="0,10,0,8"/>

                        <!-- Process Hierarchy Tree Section -->
                        <TextBlock Text="Process Hierarchy &amp; Descendant Tree:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="6">
                            <TreeView x:Name="PropProcessTree" MaxHeight="140" Background="White" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#0F172A" Width="160"/>
                                            <TextBlock Text="[PID: " Foreground="#64748B"/>
                                            <TextBlock Text="{Binding PID}" Foreground="#0284C7" FontWeight="SemiBold"/>
                                            <TextBlock Text="]  CPU: " Foreground="#64748B"/>
                                            <TextBlock Text="{Binding CPUFormatted}" Foreground="#059669" FontWeight="SemiBold" Width="50"/>
                                            <TextBlock Text=" RAM: " Foreground="#64748B"/>
                                            <TextBlock Text="{Binding MemoryFormatted}" Foreground="#7C3AED" Width="65"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: TCP Connections -->
            <TabItem Header="TCP Connections">
                <DataGrid x:Name="GridNetConnections" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          SelectionMode="Single" 
                          HeadersVisibility="Column" 
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          AlternatingRowBackground="#F8FAFC"
                          Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="70"/>
                        <DataGridTextColumn Header="Local Endpoint" Binding="{Binding LocalEndpoint}" Width="180"/>
                        <DataGridTextColumn Header="Remote Endpoint" Binding="{Binding RemoteEndpoint}" Width="190"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Actions Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnPropEndProcess" Content="Kill Process" Width="100" Height="28" Margin="0,0,8,0" Background="#EF4444" Foreground="White" FontWeight="SemiBold"/>
            <Button x:Name="BtnPropEndTree" Content="Kill Process Tree" Width="120" Height="28" Margin="0,0,12,0" Background="#DC2626" Foreground="White" FontWeight="SemiBold"/>
            <Button x:Name="BtnCloseProp" Content="Close" Width="90" Height="28" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
